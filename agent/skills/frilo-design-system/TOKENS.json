{
  "$schema": "frilo-os/core-tokens",
  "note": "Primitives only. Brands override semantic slots in brands/*.json. Never hardcode these values in a skill or component.",
  "space": { "unit": 4, "scale": [0, 4, 8, 12, 16, 24, 32, 48, 64, 96, 128] },
  "radius": { "none": 0, "sm": 6, "md": 10, "lg": 16, "xl": 24, "full": 9999 },
  "type": {
    "scale": { "xs": 12, "sm": 14, "base": 16, "lg": 18, "xl": 22, "2xl": 28, "3xl": 36, "4xl": 48, "display": 64 },
    "leading": { "tight": 1.1, "snug": 1.25, "normal": 1.5, "relaxed": 1.65 },
    "tracking": { "tight": "-0.02em", "normal": "0", "wide": "0.04em" }
  },
  "motion": {
    "duration": { "instant": 80, "fast": 160, "base": 240, "slow": 400, "reveal": 600 },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "decel": "cubic-bezier(0, 0, 0, 1)",
      "accel": "cubic-bezier(0.3, 0, 1, 1)",
      "spring": { "stiffness": 380, "damping": 30 }
    }
  },
  "elevation": {
    "sm": "0 1px 2px rgba(0,0,0,0.24)",
    "md": "0 4px 12px rgba(0,0,0,0.28)",
    "lg": "0 12px 32px rgba(0,0,0,0.36)"
  },
  "breakpoints": { "sm": 640, "md": 768, "lg": 1024, "xl": 1280, "2xl": 1536 },
  "z": { "base": 0, "dropdown": 100, "sticky": 200, "overlay": 300, "modal": 400, "toast": 500 }
}

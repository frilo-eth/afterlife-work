generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Logo {
  id            String        @id @default(cuid())
  title         String
  /// Public path segment — `/agave-sunshine`. Stable after create; unique.
  slug          String        @unique
  description   String
  images        String[]
  thumbnail     String
  tags          String[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  priceId       String
  designerEmail String?
  designerId    String?
  status        LogoStatus    @default(HIDDEN)

  // Deliverable archive handed to the buyer. Stored as a Cloudinary public_id
  // rather than a URL so the file can be uploaded with authenticated access
  // and served as a short-lived signed link — a plain URL would be shareable
  // forever once any buyer had it.
  sourcePackageId   String?
  sourcePackageName String?
  sourcePackageAt   DateTime?

  designer      Designer?     @relation("DesignerLogos", fields: [designerId], references: [id])
  price         Price         @relation(fields: [priceId], references: [id])
  gallery       LogoGallery[]
  orders        Order[]

  @@index([status, createdAt])
}

model Price {
  id        String   @id @default(cuid())
  summon    Int
  revival   Int
  afterlife String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  logos     Logo[]
}

model Order {
  id              String   @id @default(cuid())
  logoId          String
  tier            String
  wordmark        String?
  customerEmail   String
  amount          Int
  stripeSessionId String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  domain          String?
  logo            Logo     @relation(fields: [logoId], references: [id])
}

model CheckoutLog {
  id        String   @id @default(cuid())
  type      String
  logoId    String
  tier      String
  amount    Int
  error     String?
  sessionId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LogoGallery {
  id        String   @id @default(cuid())
  logoId    String
  imageUrl  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  logo      Logo     @relation(fields: [logoId], references: [id])

  @@index([logoId])
}

model LogoSubmission {
  id           String    @id @default(cuid())
  designerName String
  email        String
  twitter      String?
  description  String
  logoUrl      String
  mockupUrls   String[]
  status       String    @default("PENDING")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  designerId   String?
  designer     Designer? @relation(fields: [designerId], references: [id])

  @@map("logo_submissions")
}

model Designer {
  id          String           @id @default(cuid())
  name        String
  email       String           @unique
  twitter     String?
  website     String?
  bio         String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  logos       Logo[]           @relation("DesignerLogos")
  submissions LogoSubmission[]
}

enum LogoStatus {
  AVAILABLE
  SOLD
  HIDDEN
  REVIEW
  DRAFT
  /// Soft-deleted. Hidden from the storefront; purgeable from admin Trash.
  TRASH
}

enum OrderStatus {
  SUMMONED
  REVIVED
}

enum OrderTier {
  summon
  revival
  afterlife
}
